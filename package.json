{
  "name": "medaithon-2026-barcode-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "node server.js",
    "build": "cd frontend && npm run build",
    "start": "node server.js",
    "import": "node -e \"require('./server.js')\" && sleep 2 && curl -X POST http://localhost:3001/api/import"
  },
  "dependencies": {
    "@zxing/library": "^0.23.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "mongoose": "^9.11.3",
    "qrcode.react": "^4.2.0",
    "react-webcam": "^7.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}